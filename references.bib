@article{ref28,
  title    = {AI-driven simulation-based research: A new frontier in research innovation},
  journal  = {Computers and Education: Artificial Intelligence},
  volume   = {9},
  pages    = {100453},
  year     = {2025},
  issn     = {2666-920X},
  doi      = {https://doi.org/10.1016/j.caeai.2025.100453},
  url      = {https://www.sciencedirect.com/science/article/pii/S2666920X25000931},
  author   = {Chak-Him Fung and Siu-Ping Ng},
  keywords = {Artificial Intelligence (AI), Simulation-based research, Empirical research, Methodology, Normative research, Traditional research, Research method},
  abstract = {Artificial intelligence (AI) demonstrates growing potential to enhance and support various disciplines in research activities, including literature review and academic writing. Nevertheless, there is currently insufficient evidence about its efficacy in facilitating simulation-based research. This position paper discusses the implication of AI in research methodology and demonstrates how to use AI to conduct simulation-based research. The demonstration indicates that AI-driven simulation-based research is feasible and possesses numerous advantages. Moreover, the differences between AI-driven simulation-based research and traditional research methods are discussed. This position paper provides researchers with an initial understanding of AI-driven simulation-based research and its applications for research goals.}
}

